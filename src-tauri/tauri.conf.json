{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modesty Scanner - nsfw toolkit",
  "version": "0.1.0",
  "identifier": "org.nsfwscanner.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "src/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Modesty Scanner - nsfw toolkit",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}